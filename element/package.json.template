{
  "name": "@sveadmin/element",
  "version": "${VERSION_NAME}",
  "description": "Helper components to dispay dynamic administration pages with Svelte",
  "keywords": [
    "svelte",
    "admin",
    "reactive"
  ],
  "engines": {
    "node": ">= 16.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sveadmin/element.git"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "main": "./dist/index.js"
    },
    "./router": {
      "main": "./dist/router/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "package": "svelte-kit sync && svelte-package && publint",
    "test": "vitest run"
  },
  "dependencies": {
    "svelte": "^5.0.0-next.242",
    "@sveltejs/kit": "^2.5.25",
    "@sveadmin/common": "^0.1.12"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/package": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-svelte": "^2.36.0-next.4",
    "publint": "^0.1.9",
    "svelte": "^5.0.0-next.241",
    "svelte-check": "^3.6.0",
    "svelte-preprocess": "^5.1.4",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.11",
    "vitest": "^1.2.0"
  }
}
